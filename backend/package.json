{
  "name": "tutorias-backend",
  "version": "1.0.0",
  "description": "Backend - Sistema Web de Gestion y Seguimiento de Tutorias Academicas entre Pares",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/db/run-sql.js src/db/schema.sql",
    "db:seed": "node src/db/run-sql.js src/db/seed.sql",
    "db:migrate": "node src/db/run-sql.js src/db/migration_autenticador_logs.sql src/db/migration_coordinador_notificaciones.sql src/db/migration_timezone.sql",
    "db:reset": "node src/db/run-sql.js src/db/schema.sql src/db/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^13.5.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
