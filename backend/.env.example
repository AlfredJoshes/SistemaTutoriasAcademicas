PORT=4000

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres #agregue su contraseña de postgres
PGDATABASE=tutorias_pares

JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=8h

# Autenticador de segundo factor (TOTP)
JWT_2FA_EXPIRES_IN=5m
TOTP_ISSUER=Tutorias Pares USB
# Llave para cifrar los secretos del autenticador (32+ caracteres).
# Si se deja vacia se usa JWT_SECRET. No la cambies con cuentas ya activadas:
# los secretos guardados dejarian de poder descifrarse.
TOTP_ENC_KEY=cambia_esto_por_otra_clave_larga_y_distinta
